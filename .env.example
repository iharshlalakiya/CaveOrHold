# Copy this file to .env and fill in your values.

# Groq API key (free tier) — required when RUN_MODE=groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face token — OPTIONAL. Only needed if RUN_MODE=local with a gated model, or RUN_MODE=api.
HF_TOKEN=

# Mode: "groq" uses the free Groq API (fast, recommended), "local" runs models via transformers
# on this machine, "api" uses the free HF Inference API
RUN_MODE=local

# Model used for Agent A (starts out correct, must resist manipulation)
AGENT_A_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Model used for Agent B (deliberately wrong, argues confidently/manipulatively)
AGENT_B_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Sentence-transformers model used for answer verification (always runs fully local, no key needed)
VERIFIER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of debate rounds before Agent A gives its final answer
NUM_ROUNDS=3

# Device for local inference (only used when RUN_MODE=local): cpu, cuda, or mps
DEVICE=cpu
